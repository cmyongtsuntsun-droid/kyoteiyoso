Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/(?:en|zh-cn|zh-tw|ko)/?$
RewriteCond %{REQUEST_URI} !^/(?:index\.html|racers\.html|links\.html|robots\.txt|sitemap\.xml|indexnow-key\.txt|CNAME|site\.webmanifest|site-l10n\.js|kyoteiyoso-i18n\.js|catalog-translations\.json|(?:(?:race/\d{8}(?:/\d{1,2})?(?:/index\.html)?/?|racers/\d{4,5}\.html|stadium/\d{1,2}(?:/index\.html)?/?)))$
RewriteCond %{REQUEST_URI} !^/(?:en|zh-cn|zh-tw|ko)/(?:(?:index\.html|racers\.html|links\.html|robots\.txt|sitemap\.xml|indexnow-key\.txt|CNAME|site\.webmanifest|site-l10n\.js|kyoteiyoso-i18n\.js|catalog-translations\.json|(?:(?:race/\d{8}(?:/\d{1,2})?(?:/index\.html)?/?|racers/\d{4,5}\.html|stadium/\d{1,2}(?:/index\.html)?/?)))|(?:assets|images|api/v1)/[A-Za-z0-9_./-]+\.(?:html|json|js|css|svg|png|jpe?g|webp|ico|woff2?|webmanifest))$
RewriteCond %{REQUEST_URI} !^/(?:assets|images)/[A-Za-z0-9_./-]+\.(?:css|js|mjs|json|svg|png|jpe?g|webp|ico|woff2?|webmanifest)$
RewriteCond %{REQUEST_URI} !^/api/v1/(?:predict|racers)/[A-Za-z0-9_.-]+\.(?:json|js)$
RewriteCond %{REQUEST_URI} !^/articles/[A-Za-z0-9_.-]+\.html$
RewriteRule ^ - [F,L]

<FilesMatch "(?i)(^\\.|\\.(?:bak|conf|db|dist|ini|log|old|orig|php|py|sh|sql|sqlite3?|swp|tmp|ya?ml))$">
  Require all denied
</FilesMatch>
ErrorDocument 404 /index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\\.(?:png|ico|js|json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
